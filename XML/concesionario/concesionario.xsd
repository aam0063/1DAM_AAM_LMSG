<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="concesionario">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="coche" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="marca" type="xs:string"/>
                            <xs:element name="modelo" type="xs:string"/>

                            <!-- Puede tener cilindrada o caballos -->
                            <xs:choice>
                                <xs:element name="cilindrada" type="xs:decimal"/>
                                <xs:element name="caballos" type="xs:integer"/>
                            </xs:choice>

                            <xs:element name="combustible" type="xs:string"/>
                            <xs:element name="precio" type="xs:string"/>
                            <xs:element name="año" type="xs:integer" minOccurs="0"/>
                            <xs:element name="color" type="xs:string"/>

                            <!-- Puede haber varios interesados o ninguno -->
                            <xs:element name="interesado" type="xs:string"
                                minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>

                        <!-- Atributo obligatorio -->
                        <xs:attribute name="matricula" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>

            <!-- Atributo del elemento raíz -->
            <xs:attribute name="provincia" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
