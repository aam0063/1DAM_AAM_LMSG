<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="concesionario">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="coche" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="marca" type="xs:string"/>
                            <xs:element name="modelo" type="xs:string"/>

                            <!-- Puede tener cilindrada o caballos -->
                            <xs:choice>
                                <xs:element name="cilindrada" type="xs:decimal"/>
                                <xs:element name="caballos" type="tipocaballo"/>
                            </xs:choice>

                            <xs:element name="combustible" type="xs:string"/>
                            <xs:element name="precio" type="xs:string"/>
                            <xs:element name="año" type="tipoaño" minOccurs="0"/>
                            <xs:element name="color" type="xs:string"/>

                            <!-- Puede haber varios interesados o ninguno -->
                            <xs:element name="interesado" type="tipodni"
                                minOccurs="0" maxOccurs="unbounded"/>

                            <xs:element name="accesarios" minOccurs="0" type="tresaccesarios"></xs:element>
                        </xs:sequence>

                        <!-- Atributo obligatorio -->
                        <xs:attribute name="matricula" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>

            <!-- Atributo del elemento raíz -->
            <xs:attribute name="provincia" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="tipocombstible">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Diesel"></xs:enumeration>
            <xs:enumeration value="Gasolina"></xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipocaballo">
        <xs:restriction base="xs:unsignedShort">
            <xs:minInclusive value="60"></xs:minInclusive>
            <xs:maxInclusive value="180"></xs:maxInclusive>
        </xs:restriction>
    </xs:simpleType>

    <!--Año de 4 cifras-->
    <xs:simpleType name="tipoaño">
        <xs:restriction base="xs:unsignedShort">
            <xs:totalDigits value="4"></xs:totalDigits>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipodni">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{8}[A-Z]"></xs:pattern>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoaccesorio">
        <xs:list itemType="xs:string"></xs:list>
    </xs:simpleType>

    <xs:simpleType name="tresaccesorios">
        <xs:restriction base="tipoaccesorio">
            <xs:maxLength value="3"></xs:maxLength>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
