<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/css" href="componentes.css"?>

<!DOCTYPE listacomponentes [

<!ELEMENT listacomponentes (componente+)>
<!ELEMENT componente (fabricante, tienda, contenido)>
<!ELEMENT fabricante (cif, nombre+, pais, ciudad)>
<!ELEMENT cif (#PCDATA)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT pais (#PCDATA)>
<!ELEMENT ciudad (#PCDATA)>
<!ELEMENT tienda (nombre+, direccion, telefono)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT direccion (#PCDATA)>
<!ELEMENT telefono (#PCDATA)>
<!ELEMENT contenido (descripcion, consumo, garantia, precio_sin_iva)>
<!ELEMENT descripcion (#PCDATA)>
<!ELEMENT consumo (#PCDATA)>
<!ELEMENT garantia (#PCDATA)>
<!ELEMENT precio_sin_iva (#PCDATA)>
<!ATTLIST componente id ID #REQUIRED>
<!ATTLIST tipo
  hardware #FIXED>

]> 

<listacomponentes>
  <componente id="CPU01" tipo="hardware">
    <fabricante>
      <cif>A12345678</cif>
      <nombre>Intel</nombre>
      <pais>USA</pais>
      <ciudad>Santa Clara</ciudad>
    </fabricante>
    <tienda>
      <nombre>PCComponentes</nombre>
      <direccion>Calle Mayor 12</direccion>
      <telefono>912345678</telefono>
    </tienda>
    <contenido>
      <descripcion>Procesador Intel i7</descripcion>
      <consumo>125W</consumo>
      <garantia>3 años</garantia>
      <precio_sin_iva>300</precio_sin_iva>
    </contenido>
  </componente>
</listacomponentes>
